# 统一编辑器行为，避免出现「同一文件在不同机器上行尾/缩进不一致」的 diff 噪音。
# 与 .gitattributes（只管行尾）互补：这里额外约束缩进与编码。
# 编辑器（VS Code / PyCharm / Vim 等）会自动读取本文件。

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py}]
indent_style = space
indent_size = 4

[*.{js,ts,vue,json,yml,yaml,html,css}]
indent_style = space
indent_size = 2

[*.{sh,service,conf,local}]
indent_style = space
indent_size = 4

[*.md]
# Markdown 里行尾双空格是有意义的换行语法，不能自动裁剪
trim_trailing_whitespace = false

[Caddyfile*]
indent_style = tab
