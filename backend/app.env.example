# ============================================================
# 环境变量模板
# 用法：cp app.env.example app.env && chmod 600 app.env
# ⚠️ app.env 已被 .gitignore 排除，绝不要提交进版本库
# ============================================================

# ---------- 服务 ----------
# 只监听回环地址，对外由 Caddy 反向代理
APP_HOST=127.0.0.1
# ⚠️ 用 8081 而非 8080：8080 已被本机既有服务（redisapp / redis-demo）占用，
#    两者并存可避免冲突。Caddy 反代目标也须同步为 8081。
APP_PORT=8081
# 对外访问地址
# ⚠️ 部署到服务器时，这里要填**你的**地址（Caddyfile 的 {$SITE_ADDRESS} 也取自此处）。
#    生产环境请用 https://；本机开发可用 http://127.0.0.1:8081
APP_BASE_URL=http://127.0.0.1:8081

# 站点地址（Caddy 用它做站点匹配与 default_sni）
# 有域名填域名（如 example.com），无域名填公网 IP（如 203.0.113.10）
# 留空时 deploy.sh 会尝试从 APP_BASE_URL 推导
SITE_ADDRESS=

# ---------- SQLite ----------
# 相对路径以进程工作目录为基准。systemd 里 WorkingDirectory=/opt/research-reports/backend，
# 故实际落点 = /opt/research-reports/backend/data/app.db（与 deploy.sh 创建的目录一致）
DB_PATH=data/app.db

# ---------- Redis ----------
# 与 redis-demo 共用实例，但用不同的 DB 编号隔离
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1

# ---------- 密钥（务必替换为随机值）----------
# 生成方式：openssl rand -hex 32
JWT_SECRET=
# 会话与令牌有效期（秒）
JWT_EXPIRE=86400

# ---------- 管理员 ----------
# 权限批准邮件将发送到此地址
ADMIN_EMAIL=admin@example.com

# ---------- 邮件（注册验证 + 权限批准）----------
# ⚠️ 重要：WorkBuddy 的 Agent Mail 是 MCP 工具，服务器上的程序无法调用。
#    服务器端发信必须走 SMTP，需要一个带授权码的邮箱。
#    以 163 邮箱为例：设置 → POP3/SMTP/IMAP → 开启 SMTP 服务 → 获取「授权码」
#    （授权码不是登录密码，但同样属于敏感凭证，只写入本文件、权限 600）
MAIL_ENABLED=false
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=研报站点

# ---------- 业务参数 ----------
# 注册即赠送的生成次数
DEFAULT_QUOTA=2
# 单个任务的最长等待时间（秒），超时标记 failed 且不扣次数
TASK_TIMEOUT=1800
# 任务轮询间隔建议值（秒）——供本机 worker 参考
POLL_INTERVAL=300

# ---------- Worker（本机生成端）鉴权 ----------
# 本机拉取/回传任务时放在请求头 X-Worker-Token 里。
# 生成方式：openssl rand -base64 32
WORKER_TOKEN=

# ---------- 接口文档 ----------
# /docs、/redoc、/openapi.json 会完整暴露所有接口的定义、参数与权限要求，
# 对扫描者等于一张现成的 API 地图。默认（不配置时）就是【关闭】。
# 仅在**本机开发**时设为 true，方便调试与核对接口。
ENABLE_DOCS=false
