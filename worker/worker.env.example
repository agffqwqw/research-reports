# ============================================================
# 本机 Worker 配置模板
# 用法：cp worker.env.example worker.env  然后填值
# ⚠️ worker.env 已被 .gitignore 排除，含令牌，勿提交
# ============================================================

# 服务器地址（本机开发用 127.0.0.1；部署后换成公网地址）
SERVER_URL=http://127.0.0.1:8080

# 与服务器 app.env 里的 WORKER_TOKEN 保持一致
WORKER_TOKEN=

# 技能包目录（六维度评判的流程与脚本都在这里）
SKILL_DIR=C:\Users\user\.workbuddy\skills\cninfo-report-deep-dive

# 跑技能包脚本用的 Python（需装 pdfplumber / pypdfium2）
VENV_PY=C:\Users\user\.workbuddy\binaries\python\envs\default\Scripts\python.exe

# Worker 工作目录（下载的 PDF、抽取出的全文都放这里）
WORKDIR=C:\Users\user\WorkBuddy\2026-09-09-11-16-03\.workbuddy\worker-tasks
